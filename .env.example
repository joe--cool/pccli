# Copy this file to .env for project-local config, or to ~/.pccli/.env
# for user-level config shared across directories.
# Precedence: shell environment > project .env > ~/.pccli/.env > defaults.
# Only PCCLI_ variables are supported.

PCCLI_CLIENT_ID=
PCCLI_CLIENT_SECRET=

# Optional: use local mock responses for demos, tests, and VHS recordings.
PCCLI_MOCK=false
PCCLI_MOCK_FIXTURE=testdata/mocks/services-library.json

# Optional defaults. Endpoint overrides must be HTTP(S) origins only
# (no credentials, path, query string, or fragment).
PCCLI_BASE_URL=https://api.planningcenteronline.com
PCCLI_UPLOAD_URL=https://upload.planningcenteronline.com
# Timeout must be a positive Go duration (for example, 30s or 2m).
PCCLI_TIMEOUT=30s
# Color: auto, always, or never; NO_COLOR disables auto color.
PCCLI_COLOR=auto
